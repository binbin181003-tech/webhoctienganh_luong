@page "/admin/quan_ly_khoa_hoc"
@model webhoctienganh.Pages.admin.quan_ly_khoa_hocModel
@section Styles { <link rel="stylesheet" href="~/css/admin-ui.css" asp-append-version="true" /> }

<div class="page-shell">
    <div class="section-title">
        <div>
            <p class="eyebrow">Hệ thống</p>
            <h4 class="mb-0">Quản lý khóa học</h4>
            <p class="text-muted small mb-0">Tạo, cập nhật và theo dõi các khóa đang mở.</p>
        </div>
        <a class="btn btn-brand" href="/admin/tao_khoa_hoc"><i class="bi bi-plus-lg me-1"></i>Tạo khóa học</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert-soft success mb-3">@Model.ThongBao</div>
    }

    @if (!Model.DanhSach.Any())
    {
        <div class="card-soft empty-state">Chưa có khóa học nào.</div>
    }
    else
    {
        <div class="table-responsive card-soft p-0">
            <table class="table-modern mb-0 align-middle">
                <thead class="table-light">
                <tr>
                    <th>Mã</th>
                    <th>Tên khóa</th>
                    <th>Trình độ</th>
                    <th>Học phí</th>
                    <th>Thời lượng</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var kh in Model.DanhSach)
                {
                    <tr>
                        <td>#@kh.ma_khoa_hoc</td>
                        <td class="fw-semibold">@kh.ten_khoa_hoc</td>
                        <td><span class="tag">@kh.trinh_do</span></td>
                        <td>@kh.hoc_phi.ToString("N0") VND</td>
                        <td>@kh.thoi_luong_tuan tuần</td>
                        <td class="text-end">
                            <div class="table-actions">
                                <a class="btn-table secondary" href="/admin/sua_khoa_hoc?id=@kh.ma_khoa_hoc"><i class="bi bi-pencil"></i>Sửa</a>
                                <form method="post" asp-page-handler="Xoa" class="d-inline">
                                    <input type="hidden" name="id" value="@kh.ma_khoa_hoc" />
                                    <button class="btn-table danger" type="submit" onclick="return confirm('Xóa khóa học này?')">
                                        <i class="bi bi-trash"></i>Xóa
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
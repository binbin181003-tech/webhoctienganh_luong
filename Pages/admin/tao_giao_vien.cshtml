@page "/admin/tao_giao_vien"
@model webhoctienganh.Pages.admin.tao_giao_vienModel
@section Styles {
    <link rel="stylesheet" href="~/css/admin-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-manage.css" asp-append-version="true" />
}

<div class="page-shell narrow">
    <div class="section-title">
        <div>
            <p class="eyebrow">Người dùng</p>
            <h4 class="mb-0">Tạo tài khoản giáo viên</h4>
            <p class="text-muted small mb-0">Nhập thông tin cơ bản, đặt mật khẩu cho giáo viên mới.</p>
        </div>
        <a class="btn btn-outline-dark" href="/admin/quan_ly_giao_vien">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert-soft error mb-3"><i class="bi bi-exclamation-triangle me-2"></i>@Model.ThongBao</div>
    }

    <div class="card-soft p-4">
        <div class="d-flex align-items-start gap-3 mb-3">
            <span class="step-badge">1</span>
            <div>
                <div class="fw-semibold">Thông tin cá nhân</div>
                <div class="text-muted small">Dùng để hiển thị và liên hệ.</div>
            </div>
        </div>
        <form method="post" class="form-grid gap-3">
            <div class="form-field">
                <label class="form-label">Họ tên</label>
                <input type="text" name="ho_ten" class="form-control" placeholder="VD: Trần Minh Khoa" required />
            </div>

            <div class="form-field">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" placeholder="email@domain.com" required />
                <small class="text-muted">Dùng để đăng nhập và nhận thông báo.</small>
            </div>

            <div class="form-field">
                <label class="form-label">Số điện thoại</label>
                <input type="text" name="so_dien_thoai" class="form-control" placeholder="09xxxxxxxx" required />
            </div>

            <div class="divider my-2"></div>

            <div class="d-flex align-items-start gap-3 mb-2">
                <span class="step-badge">2</span>
                <div>
                    <div class="fw-semibold">Mật khẩu</div>
                    <div class="text-muted small">Tối thiểu 6 ký tự, phân biệt hoa thường.</div>
                </div>
            </div>

            <div class="form-row-two">
                <div class="form-field">
                    <label class="form-label">Mật khẩu</label>
                    <input type="password" name="mat_khau" class="form-control" placeholder="Ít nhất 6 ký tự" required />
                </div>
                <div class="form-field">
                    <label class="form-label">Nhập lại mật khẩu</label>
                    <input type="password" name="nhap_lai_mat_khau" class="form-control" placeholder="Nhập lại mật khẩu" required />
                </div>
            </div>

            <div class="d-flex gap-2 mt-2">
                <button type="submit" class="btn btn-brand">
                    <i class="bi bi-person-plus"></i> Tạo giáo viên
                </button>
                <a class="btn btn-ghost" href="/admin/quan_ly_giao_vien">Hủy</a>
            </div>
        </form>
    </div>
</div>
@page "/admin/quan_ly_thanh_toan"
@model webhoctienganh.Pages.admin.quan_ly_thanh_toanModel
@section Styles { <link rel="stylesheet" href="~/css/admin-analytics.css" asp-append-version="true" /> }

<div class="page-shell">
    <div class="section-title">
        <div>
            <p class="eyebrow">Tài chính</p>
            <h4 class="mb-0">Quản lý thanh toán</h4>
            <p class="text-muted small mb-0">Theo dõi các giao dịch đã hoàn tất.</p>
        </div>
        <a class="btn btn-outline-dark" href="/admin/tong_quan"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    @if (!(Model.DanhSach?.Any() ?? false))
    {
        <div class="card-soft empty-state">Chưa có thanh toán nào.</div>
    }
    else
    {
        <div class="table-responsive card-soft p-0">
            <table class="table-modern mb-0 align-middle">
                <thead class="table-light">
                <tr>
                    <th>Học viên</th>
                    <th>Khóa học</th>
                    <th>Số tiền</th>
                    <th>Ngày thanh toán</th>
                    <th>Phương thức</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var t in Model.DanhSach ?? Enumerable.Empty<webhoctienganh.Pages.admin.quan_ly_thanh_toanModel.ThanhToanView>())
                {
                    <tr>
                        <td class="fw-semibold">@t.HoTen</td>
                        <td>@t.TenKhoaHoc</td>
                        <td>₫@t.SoTien.ToString("N0")</td>
                        <td>@t.NgayThanhToan.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge-soft info">@t.PhuongThuc</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
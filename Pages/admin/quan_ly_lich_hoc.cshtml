@page "/admin/quan_ly_lich_hoc"
@model webhoctienganh.Pages.admin.quan_ly_lich_hocModel
@section Styles {
    <link rel="stylesheet" href="~/css/admin-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-manage.css" asp-append-version="true" />
}

<div class="page-shell">
    <div class="section-title">
        <div>
            <p class="eyebrow">Lịch học</p>
            <h4 class="mb-0">Quản lý lịch học</h4>
            <p class="text-muted small mb-0">Kiểm soát các ca dạy / học trong tuần.</p>
        </div>
        <a class="btn btn-outline-dark" href="/admin/tong_quan"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    @if (!Model.DanhSach.Any())
    {
        <div class="card-soft empty-state">Chưa có lịch học nào.</div>
    }
    else
    {
        <div class="card-soft p-3">
            <div class="table-responsive">
                <table class="table-modern align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã</th>
                            <th>Lớp</th>
                            <th>Khóa học</th>
                            <th>Thứ</th>
                            <th>Giờ bắt đầu</th>
                            <th>Giờ kết thúc</th>
                            <th>Phòng / Link</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var l in Model.DanhSach)
                    {
                        <tr>
                            <td>#@l.MaLich</td>
                            <td>@l.MaLop</td>
                            <td class="fw-semibold">@l.TenKhoaHoc</td>
                            <td><span class="badge-soft info">@l.ThuTrongTuan</span></td>
                            <td>@l.GioBatDau</td>
                            <td>@l.GioKetThuc</td>
                            <td>@l.PhongHoc</td>
                            <td class="text-end">
                                <a class="btn-table secondary" href="/admin/sua_lich_hoc?id=@l.MaLich"><i class="bi bi-pencil"></i> Sửa</a>
                                <form method="post" asp-page-handler="Xoa" class="d-inline">
                                    <input type="hidden" name="id" value="@l.MaLich" />
                                    <button type="submit" class="btn-table danger" onclick="return confirm('Xóa lịch học này?')">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
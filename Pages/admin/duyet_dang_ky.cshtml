@page "/admin/duyet_dang_ky"
@model webhoctienganh.Pages.admin.duyet_dang_kyModel
@section Styles { <link rel="stylesheet" href="~/css/admin-ui.css" asp-append-version="true" /> }

<div class="page-shell">
    <div class="section-title">
        <div>
            <p class="eyebrow">Đăng ký</p>
            <h4 class="mb-0">Duyệt đăng ký lớp học</h4>
            <p class="text-muted small mb-0">Xác nhận / hủy các yêu cầu đang chờ.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert-soft success mb-3">@Model.ThongBao</div>
    }

    @if (!Model.DanhSach.Any())
    {
        <div class="card-soft empty-state">Chưa có đăng ký nào.</div>
    }
    else
    {
        <div class="table-responsive card-soft p-0">
            <table class="table-modern mb-0 align-middle">
                <thead class="table-light">
                <tr>
                    <th>Mã DK</th>
                    <th>Học viên</th>
                    <th>Lớp</th>
                    <th>Khóa học</th>
                    <th>Ngày ĐK</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var d in Model.DanhSach)
                {
                    <tr>
                        <td>#@d.MaDangKy</td>
                        <td>
                            <div class="fw-semibold">@d.HoTen</div>
                            <div class="text-muted small">@d.Email</div>
                        </td>
                        <td>@d.MaLop</td>
                        <td>@d.TenKhoaHoc</td>
                        <td>@d.NgayDangKy.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge-soft @(d.TrangThai=="Pending"?"warning":d.TrangThai=="ChoThanhToan"?"info":"success")">
                                @d.TrangThai
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="table-actions">
                                @if (d.TrangThai == "Pending")
                                {
                                    <form method="post" asp-page-handler="Duyet" class="d-inline">
                                        <input type="hidden" name="id" value="@d.MaDangKy" />
                                        <button class="btn-table success" type="submit"><i class="bi bi-check2"></i>Duyệt</button>
                                    </form>
                                    <form method="post" asp-page-handler="Huy" class="d-inline">
                                        <input type="hidden" name="id" value="@d.MaDangKy" />
                                        <button class="btn-table danger" type="submit"><i class="bi bi-x"></i>Hủy</button>
                                    </form>
                                }
                                else if (d.TrangThai == "ChoThanhToan")
                                {
                                    <span class="text-muted small me-2">Chờ thanh toán</span>
                                    <form method="post" asp-page-handler="Huy" class="d-inline">
                                        <input type="hidden" name="id" value="@d.MaDangKy" />
                                        <button class="btn-table danger" type="submit"><i class="bi bi-x"></i>Hủy</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Đã xử lý</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
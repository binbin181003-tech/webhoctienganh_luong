@page "/admin/quan_ly_vai_tro"
@model webhoctienganh.Pages.admin.quan_ly_vai_troModel
@section Styles {
    <link rel="stylesheet" href="~/css/admin-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-manage.css" asp-append-version="true" />
}

<div class="page-shell">
    <div class="section-title">
        <div>
            <p class="eyebrow">Hệ thống</p>
            <h4 class="mb-0">Quản lý vai trò</h4>
            <p class="text-muted small mb-0">Cập nhật quyền cho từng người dùng.</p>
        </div>
        <a class="btn btn-outline-dark" href="/admin/tong_quan"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert-soft success mb-3">@Model.ThongBao</div>
    }

    @if (!Model.DanhSach.Any())
    {
        <div class="card-soft empty-state">Chưa có người dùng.</div>
    }
    else
    {
        <div class="card-soft p-3">
            <div class="table-responsive">
                <table class="table-modern align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Vai trò hiện tại</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var u in Model.DanhSach)
                    {
                        <tr>
                            <td class="fw-semibold">@u.HoTen</td>
                            <td>@u.Email</td>
                            <td><span class="badge-soft info">@u.VaiTro</span></td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="CapNhatVaiTro" class="d-inline-flex gap-2 align-items-center">
                                    <input type="hidden" name="id" value="@u.MaNguoiDung" />
                                    <select name="vai_tro" class="form-select form-select-sm w-auto">
                                        @foreach (var r in Model.DanhSachVaiTro)
                                        {
                                            <option value="@r.ma_vai_tro" selected="@(r.ma_vai_tro == u.VaiTro)">
                                                @r.ten_vai_tro
                                            </option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-save"></i> Cập nhật</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
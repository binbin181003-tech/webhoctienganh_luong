@page "/admin/thong_ke"
@model webhoctienganh.Pages.admin.thong_keModel

<h1>Thong Ke He Thong</h1>
<hr>

<ul>
    <li><b>So hoc vien:</b> @Model.SoHocVien</li>
    <li><b>So giao vien:</b> @Model.SoGiaoVien</li>
    <li><b>So khoa hoc:</b> @Model.SoKhoaHoc</li>
    <li><b>So lop mo:</b> @Model.SoLopMo</li>
    <li><b>Doanh thu:</b> @Model.DoanhThu.ToString("N0")</li>
</ul>

<h3>Top khoa hoc theo so dang ky</h3>
<table border="1" cellpadding="5">
    <tr>
        <th>Khoa Hoc</th>
        <th>So Dang Ky</th>
    </tr>
    @foreach (var t in Model.TopKhoaHoc)
    {
        <tr>
            <td>@t.TenKhoaHoc</td>
            <td>@t.SoDangKy</td>
        </tr>
    }
</table>

<br>
<a href="/admin/tong_quan">Quay lai</a>
@page "/dang_ky"
@model webhoctienganh.Pages.dang_kyModel

<h1>Dang Ky</h1>
<hr>

@if (!string.IsNullOrEmpty(Model.ThongBao))
{
    <p style="color:red;">@Model.ThongBao</p>
}

<form method="post">
    <div>
        <label>Ho Ten:</label><br>
        <input type="text" name="ho_ten" required />
    </div>
    <br>
    <div>
        <label>Email:</label><br>
        <input type="email" name="email" required />
    </div>
    <br>
    <div>
        <label>So Dien Thoai:</label><br>
        <input type="text" name="so_dien_thoai" required />
    </div>
    <br>
    <div>
        <label>Mat Khau:</label><br>
        <input type="password" name="mat_khau" required />
    </div>
    <br>
    <div>
        <label>Nhap Lai Mat Khau:</label><br>
        <input type="password" name="nhap_lai_mat_khau" required />
    </div>
    <br>
    <button type="submit">Dang Ky</button>
</form>

<br>
<a href="/trang_vang_lai">Quay lai</a>
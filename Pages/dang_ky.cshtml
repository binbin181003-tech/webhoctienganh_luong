@page "/dang_ky"
@model webhoctienganh.Pages.dang_kyModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đăng ký";
}

<link rel="stylesheet" href="~/css/dang_ky.css" asp-append-version="true" />

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="brand">
                <div class="brand-logo">WE</div>
                <div class="brand-text">
                    <span class="brand-title">Web Học Tiếng Anh</span>
                    <span class="brand-sub">Tạo tài khoản mới</span>
                </div>
            </div>
            <p class="welcome">Bắt đầu hành trình học tập ngay hôm nay.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ThongBao))
        {
            <div class="alert error">@Model.ThongBao</div>
        }

        <form method="post" class="auth-form">
            <label class="field">
                <span>Họ tên</span>
                <input type="text" name="ho_ten" placeholder="Nguyễn Văn A" required />
            </label>

            <label class="field">
                <span>Email</span>
                <input type="email" name="email" placeholder="email@domain.com" required />
            </label>

            <label class="field">
                <span>Số điện thoại</span>
                <input type="text" name="so_dien_thoai" placeholder="09xxxxxxxx" required />
            </label>

            <div class="row">
                <label class="field flex-1">
                    <span>Mật khẩu</span>
                    <input type="password" name="mat_khau" placeholder="ít nhất 6 ký tự" required />
                </label>
                <label class="field flex-1">
                    <span>Nhập lại mật khẩu</span>
                    <input type="password" name="nhap_lai_mat_khau" placeholder="nhập lại mật khẩu" required />
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn primary">Đăng ký</button>
                <a class="link" href="/dang_nhap">Đã có tài khoản? Đăng nhập</a>
            </div>
        </form>
    </div>
</div>
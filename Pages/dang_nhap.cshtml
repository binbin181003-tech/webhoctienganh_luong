@page "/dang_nhap"
@model webhoctienganh.Pages.dang_nhapModel
@section Styles { <link rel="stylesheet" href="~/css/dang_nhap.css" asp-append-version="true" /> }
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-wrapper">
    <div class="auth-card card-soft">
        <div class="d-flex align-items-start justify-content-between mb-3">
            <div>
                <div class="brand-logo">WE</div>
                <h5 class="fw-bold mt-2 mb-1">Web Học Tiếng Anh</h5>
                <p class="text-muted small mb-0">Đăng nhập để tiếp tục.</p>
            </div>
            <a class="small text-muted" href="/trang_vang_lai"><i class="bi bi-arrow-left"></i> Trang chủ</a>
        </div>

        @if (!string.IsNullOrEmpty(Model.ThongBao))
        {
            <div class="alert alert-danger rounded-3 small">@Model.ThongBao</div>
        }

        <form method="post" class="vstack gap-3">
            <div class="form-floating">
                <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" required>
                <label for="email">Email</label>
            </div>
            <div class="form-floating position-relative">
                <input type="password" class="form-control" id="mat_khau" name="mat_khau" placeholder="••••••" required>
                <label for="mat_khau">Mật khẩu</label>
                <button type="button" class="btn btn-link position-absolute top-50 end-0 translate-middle-y pe-3 text-muted small"
                        onclick="togglePw()">Hiện</button>
            </div>
            <button type="submit" class="btn btn-brand w-100">Đăng nhập</button>
            <div class="text-center small text-muted">
                Chưa có tài khoản? <a href="/dang_ky">Đăng ký</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function togglePw(){
  const i = document.getElementById('mat_khau');
  i.type = i.type === 'password' ? 'text' : 'password';
}
</script>
}
@page "/teacher/sua_thong_tin"
@model webhoctienganh.Pages.teacher.sua_thong_tinModel
@section Styles { <link rel="stylesheet" href="~/css/teacher_profile.css" asp-append-version="true" /> }

<div class="page-shell narrow">
    <div class="section-title">
        <div>
            <p class="eyebrow">Hồ sơ</p>
            <h4 class="mb-0">Chỉnh sửa @Model.Field</h4>
        </div>
        <a class="btn btn-outline-dark" href="/teacher/thong_tin_ca_nhan"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert-soft error mb-3">@Model.ThongBao</div>
    }

    <div class="card-soft p-4">
        <form method="post" class="vstack gap-3">
            <input type="hidden" name="field" value="@Model.Field" />
            <div class="form-floating">
                <input type="text" name="gia_tri_cu" class="form-control" placeholder="Giá trị cũ" required />
                <label>Nhập lại dữ liệu cũ</label>
            </div>
            <div class="form-floating">
                <input type="text" name="gia_tri_moi" class="form-control" placeholder="Giá trị mới" required />
                <label>Nhập dữ liệu mới</label>
            </div>
            <div class="form-floating">
                <input type="text" name="xac_nhan" class="form-control" placeholder="Xác nhận" required />
                <label>Xác nhận dữ liệu mới</label>
            </div>
            <button class="btn btn-brand w-100" type="submit"><i class="bi bi-save me-1"></i>Lưu thay đổi</button>
        </form>
    </div>
</div>
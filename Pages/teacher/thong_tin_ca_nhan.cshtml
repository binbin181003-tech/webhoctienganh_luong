@page "/teacher/thong_tin_ca_nhan"
@model webhoctienganh.Pages.teacher.thong_tin_ca_nhanModel
@section Styles { <link rel="stylesheet" href="~/css/teacher_profile.css" asp-append-version="true" /> }

<div class="page-shell narrow">
    <div class="section-title">
        <div>
            <p class="eyebrow">Hồ sơ</p>
            <h4 class="mb-0">Thông tin cá nhân</h4>
            <p class="text-muted small mb-0">Cập nhật ảnh đại diện và thông tin liên hệ.</p>
        </div>
        <a class="btn btn-outline-dark" href="/teacher/tong_quan"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert-soft error mb-3">@Model.ThongBao</div>
    }

    <div class="card-soft p-4 mb-3 profile-card">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="avatar-lg">
                @if (!string.IsNullOrEmpty(Model.CurrentUser.anh_dai_dien))
                {
                    <img src="@Model.CurrentUser.anh_dai_dien" alt="avatar" />
                }
                else
                {
                    <span>@(!string.IsNullOrEmpty(Model.CurrentUser.ho_ten) ? Model.CurrentUser.ho_ten[0] : 'G')</span>
                }
            </div>
            <div class="flex-grow-1">
                <div class="fw-bold fs-5 mb-1">@Model.CurrentUser.ho_ten</div>
                <div class="text-muted small">@Model.CurrentUser.email</div>
                <div class="d-flex gap-2 flex-wrap mt-2">
                    <form method="post" asp-page-handler="UploadAvatar" enctype="multipart/form-data" class="d-flex gap-2 align-items-center">
                        <input type="file" name="anh_dai_dien" accept="image/*" required class="form-control form-control-sm" />
                        <button class="btn btn-sm btn-primary">Tải ảnh</button>
                    </form>
                    @if (!string.IsNullOrEmpty(Model.CurrentUser.anh_dai_dien))
                    {
                        <form method="post" asp-page-handler="DeleteAvatar">
                            <button class="btn btn-sm btn-outline-danger">Xóa ảnh</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card-soft">
        <div class="field-row">
            <div class="label">Họ tên</div>
            <div class="value">@Model.CurrentUser.ho_ten</div>
            <div class="action"><a class="btn btn-sm btn-outline-primary" href="/teacher/sua_thong_tin?field=ho_ten">Chỉnh sửa</a></div>
        </div>
        <div class="field-row">
            <div class="label">Email</div>
            <div class="value">@Model.CurrentUser.email</div>
            <div class="action"><span class="text-muted small">Không thay đổi</span></div>
        </div>
        <div class="field-row">
            <div class="label">Số điện thoại</div>
            <div class="value">@Model.CurrentUser.so_dien_thoai</div>
            <div class="action"><a class="btn btn-sm btn-outline-primary" href="/teacher/sua_thong_tin?field=so_dien_thoai">Chỉnh sửa</a></div>
        </div>
        <div class="field-row">
            <div class="label">Mật khẩu</div>
            <div class="value">******</div>
            <div class="action"><a class="btn btn-sm btn-outline-primary" href="/teacher/sua_thong_tin?field=mat_khau">Đổi mật khẩu</a></div>
        </div>
    </div>
</div>
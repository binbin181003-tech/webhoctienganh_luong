@page "/teacher/tao_bai_kiem_tra"
@model webhoctienganh.Pages.teacher.tao_bai_kiem_traModel
@section Styles { <link rel="stylesheet" href="~/css/teacher-quiz.css" asp-append-version="true" /> }

<div class="page-shell narrow">
    <div class="section-title">
        <div>
            <p class="eyebrow">Bài kiểm tra</p>
            <h4 class="mb-0">Tạo bài kiểm tra</h4>
            <p class="text-muted small mb-0">Gán cho khóa học bạn đang dạy.</p>
        </div>
        <a class="btn btn-outline-dark" href="/teacher/quan_ly_bai_kiem_tra"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert-soft error mb-3">@Model.ThongBao</div>
    }

    <div class="card-soft p-4">
        <form method="post" class="vstack gap-3">
            <div class="form-floating">
                <select name="ma_khoa_hoc" class="form-select" required>
                    <option value="">-- Chọn khóa học --</option>
                    @foreach (var kh in Model.DsKhoaHoc)
                    {
                        <option value="@kh.ma_khoa_hoc">@kh.ten_khoa_hoc (@kh.trinh_do)</option>
                    }
                </select>
                <label>Khóa học</label>
            </div>
            <div class="form-floating">
                <input type="text" name="tieu_de" class="form-control" placeholder="Tiêu đề" required />
                <label>Tiêu đề bài kiểm tra</label>
            </div>
            <div class="form-floating">
                <input type="number" name="thoi_luong_phut" min="1" class="form-control" placeholder="Thời lượng" required />
                <label>Thời lượng (phút)</label>
            </div>
            <button class="btn btn-brand w-100" type="submit"><i class="bi bi-save me-1"></i>Lưu bài kiểm tra</button>
        </form>
    </div>
</div>
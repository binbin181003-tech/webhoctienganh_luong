@page "/teacher/tao_bai_kiem_tra"
@model webhoctienganh.Pages.teacher.tao_bai_kiem_traModel

<h1>Tao Bai Kiem Tra</h1>
<hr>

@if (Model.ThongBao != "")
{
    <p style="color:red;">@Model.ThongBao</p>
}

<form method="post">
    <div>
        <label>Khoa Hoc:</label><br>
        <select name="ma_khoa_hoc" required>
            <option value="">-- Chon --</option>
            @foreach (var kh in Model.DsKhoaHoc)
            {
                <option value="@kh.ma_khoa_hoc">@kh.ten_khoa_hoc (@kh.trinh_do)</option>
            }
        </select>
    </div>
    <br>
    <div>
        <label>Tieu De:</label><br>
        <input type="text" name="tieu_de" required />
    </div>
    <br>
    <div>
        <label>Thoi Luong (phut):</label><br>
        <input type="number" name="thoi_luong_phut" min="1" required />
    </div>
    <br>
    <button type="submit">Tao Bai Kiem Tra</button>
</form>

<br>
<a href="/teacher/quan_ly_bai_kiem_tra">Quay lai</a>
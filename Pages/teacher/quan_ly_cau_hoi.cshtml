@page "/teacher/quan_ly_cau_hoi"
@model webhoctienganh.Pages.teacher.quan_ly_cau_hoiModel
@section Styles { <link rel="stylesheet" href="~/css/teacher.css" asp-append-version="true" /> }

<h1>Quản lý câu hỏi</h1>
...
<table class="table-modern">
    <thead><tr><th>Nội dung</th><th>Đáp án</th><th></th></tr></thead>
    <tbody>
    @foreach (var q in Model.CauHois)
    {
        <tr>
            <td>@q.noi_dung</td>
            <td>
                <ul>
                    @foreach (var a in q.dap_ans)
                    { <li>@a.noi_dung @(a.la_dap_an_dung ? "(Đúng)" : "")</li> }
                </ul>
            </td>
            <td class="table-actions">
                <a class="btn-table secondary" href="/teacher/sua_cau_hoi?cauHoiId=@q.ma_cau_hoi&baiId=@Model.BaiId"><i class="bi bi-pencil"></i>Sửa</a>
                <form method="post" asp-page-handler="Xoa">
                    <input type="hidden" name="cauHoiId" value="@q.ma_cau_hoi" />
                    <input type="hidden" name="baiId" value="@Model.BaiId" />
                    <button class="btn-table danger" type="submit"><i class="bi bi-trash"></i>Xóa</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
<br>
<a class="btn-solid outline" href="/teacher/tong_quan">Quay lại</a>
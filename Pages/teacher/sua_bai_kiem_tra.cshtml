@page "/teacher/sua_bai_kiem_tra"
@model webhoctienganh.Pages.teacher.sua_bai_kiem_traModel
@section Styles { <link rel="stylesheet" href="~/css/teacher-quiz.css" asp-append-version="true" /> }

<div class="page-shell narrow">
    <div class="section-title">
        <div>
            <p class="eyebrow">Bài kiểm tra</p>
            <h4 class="mb-0">Sửa bài kiểm tra</h4>
        </div>
        <a class="btn btn-outline-dark" href="/teacher/quan_ly_bai_kiem_tra"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert-soft error mb-3">@Model.ThongBao</div>
    }

    @if (Model.BaiKiemTra != null)
    {
        <div class="card-soft p-4">
            <form method="post" class="vstack gap-3">
                <input type="hidden" name="id" value="@Model.BaiKiemTra.ma_bai_kiem_tra" />
                <div class="form-floating">
                    <input type="text" name="tieu_de" class="form-control" value="@Model.BaiKiemTra.tieu_de" required />
                    <label>Tiêu đề</label>
                </div>
                <div class="form-floating">
                    <input type="number" name="thoi_luong_phut" min="1" class="form-control" value="@Model.BaiKiemTra.thoi_luong_phut" required />
                    <label>Thời lượng (phút)</label>
                </div>
                <button class="btn btn-brand w-100" type="submit"><i class="bi bi-save me-1"></i>Lưu thay đổi</button>
            </form>
        </div>
    }
</div>
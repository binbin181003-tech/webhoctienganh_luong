@page "/teacher/lop_dang_day"
@model webhoctienganh.Pages.teacher.lop_dang_dayModel
@section Styles { <link rel="stylesheet" href="~/css/teacher.css" asp-append-version="true" /> }

<h1>Danh sách lớp đang dạy</h1>
<hr>

<table class="table-modern">
    <thead>
    <tr>
        <th>Mã Lớp</th><th>Khóa Học</th><th>Bắt Đầu</th><th>Kết Thúc</th><th>Sĩ Số</th><th>Trạng Thái</th><th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var l in Model.DanhSach)
    {
        <tr>
            <td>@l.MaLop</td>
            <td>@l.TenKhoaHoc</td>
            <td>@l.NgayBatDau.ToString("dd/MM/yyyy")</td>
            <td>@l.NgayKetThuc.ToString("dd/MM/yyyy")</td>
            <td>@l.SoLuongDangKy / @l.SoLuongToiDa</td>
            <td>@l.TrangThai</td>
            <td class="table-actions">
                <a class="btn-table" href="/teacher/danh_sach_hoc_vien?lop=@l.MaLop"><i class="bi bi-people"></i>Học viên</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.DanhSach.Any()) { <p>Chưa có lớp nào.</p> }

<br>
<a class="btn-solid outline" href="/teacher/tong_quan">Quay lại</a>
@page "/teacher/quan_ly_bai_hoc"
@model webhoctienganh.Pages.teacher.quan_ly_bai_hocModel
@section Styles { <link rel="stylesheet" href="~/css/teacher.css" asp-append-version="true" /> }

<h1>Quản lý bài học</h1>
<hr>

<a class="btn-solid" href="/teacher/tao_bai_hoc"><i class="bi bi-plus-lg"></i> Tạo bài học mới</a>
<br><br>

@if (!string.IsNullOrEmpty(Model.ThongBao))
{ <p style="color:green;">@Model.ThongBao</p> }

<table class="table-modern">
    <thead>
    <tr><th>Mã</th><th>Tiêu đề</th><th>Khóa học</th><th>Ngày tạo</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var b in Model.DanhSach)
    {
        <tr>
            <td>@b.ma_bai_hoc</td>
            <td>@b.tieu_de</td>
            <td>@b.khoa_hoc?.ten_khoa_hoc</td>
            <td>@b.ngay_tao.ToString("dd/MM/yyyy")</td>
            <td class="table-actions">
                <a class="btn-table secondary" href="/teacher/sua_bai_hoc?id=@b.ma_bai_hoc"><i class="bi bi-pencil"></i>Sửa</a>
                <form method="post" asp-page-handler="Xoa">
                    <input type="hidden" name="id" value="@b.ma_bai_hoc" />
                    <button class="btn-table danger" type="submit" onclick="return confirm('Xóa bài học này?')"><i class="bi bi-trash"></i>Xóa</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.DanhSach.Any()) { <p>Chưa có bài học nào.</p> }

<br>
<a class="btn-solid outline" href="/teacher/tong_quan">Quay lại</a>
@page "/teacher/tao_bai_hoc"
@model webhoctienganh.Pages.teacher.tao_bai_hocModel
@section Styles { <link rel="stylesheet" href="~/css/teacher-bai-hoc-form.css" asp-append-version="true" /> }

<div class="page-shell narrow">
    <div class="section-title">
        <div>
            <p class="eyebrow">Bài học</p>
            <h4 class="mb-0">Tạo bài học mới</h4>
        </div>
        <a class="btn btn-outline-dark" href="/teacher/quan_ly_bai_hoc"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert-soft error mb-3">@Model.ThongBao</div>
    }

    <div class="card-soft p-4">
        <form method="post" class="vstack gap-3">
            <div class="form-floating">
                <select name="ma_khoa_hoc" class="form-select" required>
                    <option value="">-- Chọn khóa học --</option>
                    @foreach (var kh in Model.DsKhoaHoc)
                    {
                        <option value="@kh.ma_khoa_hoc">@kh.ten_khoa_hoc (@kh.trinh_do)</option>
                    }
                </select>
                <label>Khóa học</label>
            </div>

            <div class="form-floating">
                <input type="text" name="tieu_de" class="form-control" placeholder="Tiêu đề" required />
                <label>Tiêu đề bài học</label>
            </div>

            <div class="form-floating">
                <textarea name="noi_dung" class="form-control" style="height:160px" placeholder="Nội dung"></textarea>
                <label>Nội dung</label>
            </div>

            <button class="btn btn-brand w-100" type="submit"><i class="bi bi-save me-1"></i>Lưu bài học</button>
        </form>
    </div>
</div>
@page "/student/danh_gia_khoa_hoc"
@model webhoctienganh.Pages.student.danh_gia_khoa_hocModel
@section Styles { <link rel="stylesheet" href="~/css/hoa_don.css" asp-append-version="true" /> }

<div class="page-shell">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-1">Đánh giá khóa học</h4>
            <p class="text-muted mb-0">Chọn khóa đã thanh toán để gửi phản hồi.</p>
        </div>
        <a class="btn btn-outline-dark btn-sm" href="/trang_chu"><i class="bi bi-arrow-left me-1"></i>Trang chủ</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="alert alert-danger rounded-3 mb-3">@Model.ThongBao</div>
    }

    <div class="card-soft p-3 mb-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="small text-muted mb-1">Chọn khóa học</label>
                <select name="khoaHocId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Chọn khóa đã thanh toán --</option>
                    @foreach (var kh in Model.KhoaHocHopLe)
                    {
                        <option value="@kh.ma_khoa_hoc" selected="@(Model.KhoaHoc?.ma_khoa_hoc == kh.ma_khoa_hoc)">
                            @kh.ten_khoa_hoc (@kh.trinh_do)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-auto d-none">
                <button class="btn btn-brand" type="submit">Chọn</button>
            </div>
        </form>
    </div>

    @if (Model.KhoaHoc != null)
    {
        <div class="card-soft p-4">
            <div class="d-flex justify-content-between flex-wrap gap-2 mb-3">
                <div>
                    <div class="small text-muted">Khóa học</div>
                    <h5 class="fw-bold mb-0">@Model.KhoaHoc.ten_khoa_hoc</h5>
                    <div class="text-muted small">Trình độ: @Model.KhoaHoc.trinh_do</div>
                </div>
                <div class="text-end">
                    <div class="badge-soft info">@Model.SoSao sao hiện tại</div>
                </div>
            </div>

            <form method="post" class="vstack gap-3">
                <input type="hidden" name="khoaHocId" value="@Model.KhoaHoc.ma_khoa_hoc" />
                <div class="form-floating">
                    <input type="number" name="so_sao" min="1" max="5" class="form-control" value="@Model.SoSao" required />
                    <label>Số sao (1-5)</label>
                </div>
                <div class="form-floating">
                    <textarea name="noi_dung" class="form-control" style="height:140px" required>@Model.NoiDung</textarea>
                    <label>Nội dung đánh giá</label>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-brand" type="submit"><i class="bi bi-save me-1"></i>Lưu đánh giá</button>
                    @if (Model.DaCoDanhGia)
                    {
                        <form method="post" asp-page-handler="Xoa" class="d-inline">
                            <input type="hidden" name="khoaHocId" value="@Model.KhoaHoc.ma_khoa_hoc" />
                            <button class="btn btn-outline-danger" type="submit" onclick="return confirm('Xóa đánh giá này?')">
                                <i class="bi bi-trash me-1"></i>Xóa
                            </button>
                        </form>
                    }
                </div>
            </form>
        </div>
    }
    else if (!Model.KhoaHocHopLe.Any())
    {
        <div class="card-soft empty-state">
            <p class="mb-2">Bạn chưa thanh toán khóa học nào để đánh giá.</p>
            <a class="btn btn-primary" href="/student/dang_ky_khoa_hoc">Đăng ký ngay</a>
        </div>
    }
</div>
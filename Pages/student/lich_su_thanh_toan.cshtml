@page "/student/lich_su_thanh_toan"
@model webhoctienganh.Pages.student.lich_su_thanh_toanModel
@section Styles { <link rel="stylesheet" href="~/css/hoa_don.css" asp-append-version="true" /> }

<div class="page-shell">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1">Lịch sử thanh toán</h4>
            <p class="text-muted mb-0">Tất cả các lần thanh toán của bạn.</p>
        </div>
        <a class="btn btn-outline-dark btn-sm" href="/student/hoa_don"><i class="bi bi-receipt-cutoff me-1"></i>Hóa đơn hiện tại</a>
    </div>

    @if (!Model.DanhSach.Any())
    {
        <div class="card-soft empty-state">
            <p class="mb-2">Chưa có thanh toán nào.</p>
            <a class="btn btn-primary" href="/student/hoa_don">Xem hóa đơn</a>
        </div>
    }
    else
    {
        <div class="table-responsive card-soft p-0">
            <table class="table table-modern mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Khoá học</th>
                        <th>Số tiền</th>
                        <th>Ngày thanh toán</th>
                        <th>Phương thức</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var t in Model.DanhSach)
                {
                    <tr>
                        <td class="fw-semibold">@t.TenKhoaHoc</td>
                        <td>@t.SoTien.ToString("N0") VND</td>
                        <td>@t.NgayThanhToan.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge-soft info">@t.PhuongThuc</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
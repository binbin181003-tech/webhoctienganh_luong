@page "/student/lich_su_thanh_toan"
@model webhoctienganh.Pages.student.lich_su_thanh_toanModel

<h1>Lich Su Thanh Toan</h1>
<hr>

<table border="1" cellpadding="5">
    <tr>
        <th>Khoa Hoc</th>
        <th>So Tien</th>
        <th>Ngay Thanh Toan</th>
        <th>Phuong Thuc</th>
    </tr>
    @foreach (var t in Model.DanhSach)
    {
        <tr>
            <td>@t.TenKhoaHoc</td>
            <td>@t.SoTien.ToString("N0")</td>
            <td>@t.NgayThanhToan.ToString("dd/MM/yyyy")</td>
            <td>@t.PhuongThuc</td>
        </tr>
    }
</table>

@if (!Model.DanhSach.Any())
{
    <p>Chua co thanh toan nao.</p>
}

<br>
<a href="/trang_chu">Quay lai</a>